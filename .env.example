# Tavily key: https://app.tavily.com
TAVILY_API_KEY=
# Token Factory key: https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Model for the deal search (plan, structure, price recheck). Optional.
STRUCTURE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Models for the three live roles. Optional: the defaults are used when these are empty.
# Pick instruct models. Models that think before answering burn max_tokens and return nothing.
PARSER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
RANKER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
UPDATER_MODEL=NousResearch/Hermes-4-405B
# Model that looks at product photos before they are accepted (needs image input). Optional.
VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
